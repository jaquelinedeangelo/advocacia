# =====================================================
# CONFIGURACAO DO ESCRITORIO - escritorio-jaqueline
# =====================================================
# IMPORTANTE: copie este arquivo para .env e preencha os valores reais.
# O .env nunca eh enviado pro GitHub (esta no .gitignore).

# ---- Deploy: GitHub Pages (gratuito) ----
# Voce nao precisa de FTP. O deploy eh automatico via "git push".
# Comandos basicos depois de editar arquivos da pasta paginas/:
#   git add .
#   git commit -m "atualiza pagina"
#   git push
# O GitHub Pages publica automaticamente em:
GITHUB_REPO=https://github.com/jaquelinedeangelo/advocacia
SITE_URL=https://jaquelinedeangelo.github.io/advocacia/

# ---- Supabase (preencher na Aula 1) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# ---- Meta / Facebook Ads (preencher na Aula 2) ----
META_PIXEL_ID=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# ---- WhatsApp Business API (preencher na Aula 3) ----
WPP_PHONE_NUMBER_ID=
WPP_BUSINESS_ACCOUNT_ID=
WPP_TOKEN=
